# Copy to .env (scripts/dev-setup.ps1 does this and fills in random secrets). Never commit .env.

# --- Docker Compose services ---
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me
JWT_AUDIENCE=mode-api

# Shared key between the API and the file processor, and the HMAC key for signed file links (base64, 32 bytes).
PROCESSOR_KEY=change-me
FILES_LINK_SIGNING_KEY=change-me

# Password of the read-only 'mode_reader' login on the host SQL Server (local mock only).
HOST_DIRECTORY_READER_PASSWORD=change-me

# Used only by the optional 'full' compose profile (API in Docker). Requires TCP enabled on SQL Server.
HOST_DIRECTORY_CONNECTION_STRING=Server=host.docker.internal,1433;Database=ModeHostMock;User Id=mode_reader;Password=change-me;Encrypt=True;TrustServerCertificate=True

# --- Mode API configuration keys (environment variable form) ---
# When the API runs on the host with `dotnet run`, these come from user secrets set by dev-setup.ps1.
# ConnectionStrings__Mode=Host=localhost;Port=5432;Database=mode;Username=mode;Password=...
# UserDirectory__ConnectionString=Server=.;Database=ModeHostMock;User Id=mode_reader;Password=...;TrustServerCertificate=True
# UserDirectory__Table=dbo.Users
# UserDirectory__IdType=Guid            # Guid | Int32 | Int64 | String
# UserDirectory__IdColumn=Id
# UserDirectory__DisplayNameColumn=DisplayName
# UserDirectory__EmailColumn=Email
# UserDirectory__AvatarUrlColumn=AvatarUrl   # empty if the host has none
# UserDirectory__ActiveColumn=IsActive
# UserDirectory__CacheMinutes=5
# Files__StoragePath=D:\ModeFiles            # back up together with the database
# Files__LinkSigningKey=...                   # FILES_LINK_SIGNING_KEY
# Files__ProcessorKey=...                     # PROCESSOR_KEY
# Files__AllowedExtensions__0=pdf             # replaces the default list when set
# Files__AllowedExtensions__1=docx
# Files__MaxSizeMb=100
# Files__RecoveryDays=30
# ClamAv__Host=localhost
# ClamAv__Port=3310
# Push__Subject=mailto:it-team@your-domain    # contact sent to browser push services
# Push__PublicKey=...                         # VAPID_PUBLIC_KEY (generated by dev-setup.ps1)
# Push__PrivateKey=...                        # VAPID_PRIVATE_KEY
# Email__Enabled=true
# Email__Host=smtp.gmail.com                  # or the bank's SMTP relay
# Email__Port=587
# Email__Username=...
# Email__Password=...                         # Gmail: an App Password, not the account password
# Email__FromAddress=...
# Email__AppUrl=https://host.example/mode     # link included in digests
# Auth__Issuer=https://host.example/
# Auth__Audience=mode-api
# Auth__MetadataAddress=https://host.example/.well-known/openid-configuration   # or Auth__PublicKeyPem
# Auth__RoleMap__mode-admin=Admin
# Auth__RoleMap__guest=Guest
# See docs/AUTH.md.

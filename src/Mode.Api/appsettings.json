{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30,
    "Claims": {
      "Subject": "sub",
      "Name": "name",
      "Email": "email",
      "Roles": "roles"
    },
    "RoleMap": {
      "mode-admin": "Admin",
      "guest": "Guest"
    }
  },
  "UserDirectory": {
    "Table": "dbo.Users",
    "IdType": "Guid",
    "IdColumn": "Id",
    "DisplayNameColumn": "DisplayName",
    "EmailColumn": "Email",
    "AvatarUrlColumn": "AvatarUrl",
    "ActiveColumn": "IsActive",
    "CacheMinutes": 5,
    "CommandTimeoutSeconds": 5
  },
  "Files": {
    "MaxSizeMb": 100,
    "RecoveryDays": 30,
    "UploadSessionMinutes": 15,
    "DownloadLinkMinutes": 5,
    "MaxAttachmentsPerMessage": 10
  },
  "ClamAv": {
    "Host": "localhost",
    "Port": 3310,
    "TimeoutSeconds": 300
  },
  "Jobs": {
    "Enabled": true,
    "Workers": 2,
    "PollSeconds": 2,
    "LockMinutes": 10,
    "PurgeIntervalMinutes": 60
  },
  "Presence": {
    "AwayAfterSeconds": 300,
    "SweepSeconds": 30
  },
  "Push": {
    "Subject": "",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "Email": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Mode",
    "DailyDigestHourUtc": 7,
    "AppUrl": ""
  }
}

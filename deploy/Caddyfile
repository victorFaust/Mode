{
	email {$ACME_EMAIL}
}

{$MODE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Only the file processor calls /internal, over the private Docker network.
	@api path /api/* /hubs/* /health/*
	handle @api {
		reverse_proxy api:8080 {
			# The API image has no shell tools, so Caddy checks readiness instead of Docker.
			health_uri /health/ready
			health_interval 15s
			# Large uploads and long-lived realtime connections.
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	# The built client bundle (client/dist), which the host application loads.
	handle_path /mode/* {
		root * /srv/mode
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		respond 404
	}
}

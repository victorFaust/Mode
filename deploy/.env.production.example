# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
# Generate keys with: openssl rand -base64 32

MODE_VERSION=1.0.0
MODE_DOMAIN=mode.your-bank.example
ACME_EMAIL=it-ops@your-bank.example
HOST_APP_ORIGIN=https://intranet.your-bank.example

POSTGRES_PASSWORD=change-me
HOST_DIRECTORY_CONNECTION_STRING=Server=sql.internal,1433;Database=HostApp;User Id=mode_reader;Password=change-me;Encrypt=True

# Exactly one of AUTH_METADATA_ADDRESS or AUTH_PUBLIC_KEY_PEM.
AUTH_ISSUER=https://login.your-bank.example
AUTH_AUDIENCE=mode-api
AUTH_METADATA_ADDRESS=https://login.your-bank.example/.well-known/openid-configuration
AUTH_PUBLIC_KEY_PEM=

FILES_LINK_SIGNING_KEY=change-me
PROCESSOR_KEY=change-me
COMPLIANCE_SIGNING_KEY=change-me

# Optional: browser push (npx web-push generate-vapid-keys) and email digests.
PUSH_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
